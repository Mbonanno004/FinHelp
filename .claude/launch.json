{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finhelp-api",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "finhelp-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "finhelp-api-test",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8001"],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "finhelp-web-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "FINHELP_API": "http://127.0.0.1:8001" },
      "port": 5174,
      "autoPort": false
    }
  ]
}
